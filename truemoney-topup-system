const express = require('express');
const axios = require('axios');
const cors = require('cors');
const app = express();

app.use(cors());
app.use(express.json());

const TARGET_MOBILE = "0639263897"; // เบอร์รับเงิน

app.post('/api/redeem', async (req, res) => {
    const { voucher_hash } = req.body;
    
    if (!voucher_hash) {
        return res.status(400).json({ success: false, message: 'กรุณาระบุรหัสซองอั่งเปา' });
    }

    try {
        const response = await axios.post(`https://gift.truemoney.com/campaign/v1/vouchers/${voucher_hash}/redeem`, {
            mobile: TARGET_MOBILE,
            voucher_hash: voucher_hash
        }, {
            headers: {
                'Content-Type': 'application/json',
                'User-Agent': 'Mozilla/5.0'
            }
        });

        const data = response.data;
        
        // เช็คสถานะจาก TrueMoney API (SUCCESS คือสำเร็จ)
        if (data.status && data.status.code === 'SUCCESS') {
            const amount = data.data.my_ticket ? data.data.my_ticket.amount_baht : 0;
            return res.json({ success: true, amount: amount, message: 'เติมเงินสำเร็จ' });
        } else {
            return res.json({ success: false, message: data.status?.message || 'ซองไม่ถูกต้องหรือถูกใช้งานแล้ว' });
        }

    } catch (error) {
        const errData = error.response?.data;
        let errorMsg = 'เกิดข้อผิดพลาดในการเชื่อมต่อ';
        
        if (errData && errData.status && errData.status.message) {
            errorMsg = errData.status.message;
        }
        
        res.status(500).json({ success: false, message: errorMsg });
    }
});

app.listen(3000, () => console.log('Backend is running on port 3000'));
